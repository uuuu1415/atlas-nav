PORT=3000
NODE_ENV=development
DB_PROVIDER=sqlite
SQLITE_PATH=./data/atlas-nav.db
# Optional: override uploads for isolated tests or custom deployments.
# STORAGE_PATH=./storage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-running
SESSION_SECRET=replace-with-a-long-random-secret
# PostgreSQL: set DB_PROVIDER=postgresql and use a postgres:// URL.
# DATABASE_URL=postgres://user:password@localhost:5432/atlas_nav
# MySQL: set DB_PROVIDER=mysql and use a mysql:// URL instead.
# DATABASE_URL=mysql://user:password@localhost:3306/atlas_nav
# MongoDB: set DB_PROVIDER=mongodb and configure both values below.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=atlas_nav
